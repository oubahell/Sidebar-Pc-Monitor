<UserControl x:Class="SidebarDiagnostics.Controls.ColorPickerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="Root">
    <UserControl.Resources>
        <!--
            Declared explicitly rather than inheriting the ambient TextBox style: the Settings grid
            scopes a TextBox style to DockPanel (width 50, docked right) for the slider number boxes,
            which this popup would otherwise pick up and render as a clipped, half-height field.
        -->
        <Style x:Key="HexBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ChromeForegroundBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="PART_Toggle" Height="26" Cursor="Hand" FocusVisualStyle="{x:Null}"
                      IsEnabled="{Binding IsEnabled, ElementName=Root}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd" CornerRadius="4" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
                            Background="{DynamicResource ChromeSurfaceBrush}" Padding="3">
                        <Border x:Name="Swatch" CornerRadius="2" Background="{Binding SwatchBrush, ElementName=Root}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ChromeAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ChromeAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="PART_Popup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom"
               VerticalOffset="4" PopupAnimation="Fade" PlacementTarget="{Binding ElementName=PART_Toggle}"
               IsOpen="{Binding IsChecked, ElementName=PART_Toggle, Mode=TwoWay}">
            <Border Background="{DynamicResource ChromeBackgroundBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <StackPanel Width="228">
                    <ItemsControl x:Name="PART_Presets" ItemsSource="{Binding Presets, ElementName=Root}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="24" Height="24" Margin="2" Cursor="Hand" Tag="{Binding}"
                                        Click="Preset_Click" ToolTip="{Binding}" FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="Sw" CornerRadius="4" SnapsToDevicePixels="True"
                                                    BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
                                                    Background="{Binding Converter={StaticResource HexToBrush}}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Sw" Property="BorderBrush" Value="{DynamicResource ChromeForegroundBrush}" />
                                                    <Setter TargetName="Sw" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Grid rather than DockPanel, so the DockPanel-scoped TextBox style in the
                         Settings grid cannot reach the hex field. -->
                    <Grid Margin="2,10,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Hex" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource ChromeMutedBrush}" />
                        <Border Grid.Column="1" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                Background="{DynamicResource ChromeSurfaceBrush}">
                            <TextBox x:Name="PART_Hex" MaxLength="7" Style="{StaticResource HexBoxStyle}"
                                     KeyDown="Hex_KeyDown" LostFocus="Hex_LostFocus" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
