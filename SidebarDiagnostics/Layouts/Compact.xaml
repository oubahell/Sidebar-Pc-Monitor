<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:monitor="clr-namespace:SidebarDiagnostics.Monitoring"
        xmlns:frame="clr-namespace:SidebarDiagnostics.Framework">

    <!--
        Compact - the same information in less vertical space.

        The label is dimmed and the value carries the emphasis, so a dense stack of readings still
        scans quickly: the eye follows the bright column of numbers and only stops at the labels
        when it needs to. Row padding is trimmed rather than the font, so it stays readable.
    -->
    <DataTemplate x:Key="MetricTemplate" DataType="{x:Type monitor:iMetric}">
        <DockPanel Margin="0,0,0,1">
            <!-- The user's own font colour at reduced opacity, not a fixed grey, so the label stays
                 legible against whatever background and colour they have chosen. -->
            <TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.75"
                       Text="{Binding Path=Label, Mode=OneWay}"
                       Foreground="{Binding Source={x:Static frame:Settings.Instance}, Path=FontColor, Mode=OneWay}"
                       FontSize="{Binding Source={x:Static frame:Settings.Instance}, Path=FontSetting.SmallFontSize, Mode=OneWay}" />

            <TextBlock HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="{Binding Path=Text, Mode=OneWay}"
                       FontSize="{Binding Source={x:Static frame:Settings.Instance}, Path=FontSetting.FontSize, Mode=OneWay}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="{Binding Source={x:Static frame:Settings.Instance}, Path=FontColor, Mode=OneWay}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=IsAlert, Mode=OneWay}" Value="True">
                                <Setter Property="Foreground" Value="{Binding Path=AlertColor, Mode=OneWay}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
