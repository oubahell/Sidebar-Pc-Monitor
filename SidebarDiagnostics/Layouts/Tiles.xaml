<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:monitor="clr-namespace:SidebarDiagnostics.Monitoring"
        xmlns:frame="clr-namespace:SidebarDiagnostics.Framework">

    <!--
        Tiles - each reading on its own raised card, value first.

        The value is set large and the label small beneath it, so the number reads at a glance from
        across the room and the label is there only to identify it. Costs more vertical space than
        the other layouts, so it suits a wider sidebar or a short list of readings.
    -->
    <DataTemplate x:Key="MetricTemplate" DataType="{x:Type monitor:iMetric}">
        <Border Margin="0,0,0,4" Padding="8,5" CornerRadius="5" SnapsToDevicePixels="True"
                Background="{DynamicResource ChromeSurfaceBrush}"
                BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock TextTrimming="CharacterEllipsis"
                           Text="{Binding Path=Text, Mode=OneWay}"
                           FontWeight="SemiBold"
                           FontSize="{Binding Source={x:Static frame:Settings.Instance}, Path=FontSetting.TitleFontSize, Mode=OneWay}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{Binding Source={x:Static frame:Settings.Instance}, Path=FontColor, Mode=OneWay}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsAlert, Mode=OneWay}" Value="True">
                                    <Setter Property="Foreground" Value="{Binding Path=AlertColor, Mode=OneWay}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- The user's own font colour at reduced opacity, not a fixed grey. -->
                <TextBlock Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Opacity="0.75"
                           Text="{Binding Path=FullName, Mode=OneWay}"
                           Foreground="{Binding Source={x:Static frame:Settings.Instance}, Path=FontColor, Mode=OneWay}"
                           FontSize="{Binding Source={x:Static frame:Settings.Instance}, Path=FontSetting.SmallFontSize, Mode=OneWay}" />

                <!-- A thin fill under the card, for readings where a proportion is meaningful. -->
                <ProgressBar Minimum="0" Maximum="100" Height="3" Margin="0,4,0,0"
                             Value="{Binding Path=Value, Mode=OneWay}"
                             Background="{DynamicResource ChromeSurfaceHoverBrush}"
                             BorderThickness="0">
                    <ProgressBar.Style>
                        <Style TargetType="{x:Type ProgressBar}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource ChromeAccentBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                                        <Border CornerRadius="2" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                            <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                                    Background="{TemplateBinding Foreground}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsPercent, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=IsAlert, Mode=OneWay}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ChromeDangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
