<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:monitor="clr-namespace:SidebarDiagnostics.Monitoring"
        xmlns:frame="clr-namespace:SidebarDiagnostics.Framework">

    <!--
        Bars - a fill bar under anything measured as a percentage, in the spirit of the classic
        hardware-monitor overlays.

        Only percentages get a bar. A load figure has a natural full scale, so the bar means
        something; a clock speed or a wattage does not, and drawing one against an invented maximum
        would imply headroom that isn't real. Those readings fall back to plain text, which is why
        the bar row collapses on IsPercent rather than always being present.

        The fill is driven by a LinearGradientBrush whose stops are placed from Value, so the bar
        colours itself: cool at low load, warming as it fills.
    -->
    <DataTemplate x:Key="MetricTemplate" DataType="{x:Type monitor:iMetric}">
        <StackPanel Margin="0,0,0,3">
            <DockPanel>
                <!-- The label takes the user's own font colour at reduced opacity rather than a
                     fixed grey: a hardcoded grey ignores their colour choice and reads as washed
                     out against the sidebar's background. -->
                <TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.75"
                           Text="{Binding Path=Label, Mode=OneWay}"
                           Foreground="{Binding Source={x:Static frame:Settings.Instance}, Path=FontColor, Mode=OneWay}"
                           FontSize="{Binding Source={x:Static frame:Settings.Instance}, Path=FontSetting.SmallFontSize, Mode=OneWay}" />

                <TextBlock HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding Path=Text, Mode=OneWay}"
                           FontSize="{Binding Source={x:Static frame:Settings.Instance}, Path=FontSetting.FontSize, Mode=OneWay}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{Binding Source={x:Static frame:Settings.Instance}, Path=FontColor, Mode=OneWay}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsAlert, Mode=OneWay}" Value="True">
                                    <Setter Property="Foreground" Value="{Binding Path=AlertColor, Mode=OneWay}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>

            <ProgressBar Minimum="0" Maximum="100" Height="4" Margin="0,2,0,0"
                         Value="{Binding Path=Value, Mode=OneWay}"
                         Background="{DynamicResource ChromeSurfaceHoverBrush}"
                         BorderThickness="0">
                <ProgressBar.Style>
                    <Style TargetType="{x:Type ProgressBar}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Foreground" Value="{DynamicResource ChromeAccentBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ProgressBar}">
                                    <Border CornerRadius="2" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                        <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                                Background="{TemplateBinding Foreground}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=IsPercent, Mode=OneWay}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=IsAlert, Mode=OneWay}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ChromeDangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
