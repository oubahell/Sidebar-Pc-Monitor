<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:style="clr-namespace:SidebarDiagnostics.Style"
        x:Class="SidebarDiagnostics.Style.FlatStyle"
        x:ClassModifier="public">
    
    <!--
        Window caption controls. Modelled on the Windows 11 title bar: flat, borderless,
        icon-only, with the hover state carried by a subtle background fill (red for close)
        rather than the coloured "traffic light" circles this used to draw.
    -->
    <Style x:Key="WindowControlButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource ChromeMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChromeSurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="{x:Type Path}">
                <Setter Property="Stroke" Value="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                <Setter Property="StrokeThickness" Value="1.1" />
                <Setter Property="StrokeStartLineCap" Value="Square" />
                <Setter Property="StrokeEndLineCap" Value="Square" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="WindowCloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowControlButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChromeDangerBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DragThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Polygon Points="6,6 6,0 0,6" Fill="#95A5A6" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="FlatWindowStyle" TargetType="{x:Type style:FlatWindow}">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="Background" Value="{DynamicResource ChromeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type style:FlatWindow}">
                    <Border x:Name="PART_BORDER" Margin="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Direction="-90" ShadowDepth="2" Opacity="0.5" Color="{DynamicResource ChromeShadowColor}" />
                        </Border.Effect>
                        <Grid>
                            <DockPanel LastChildFill="True">
                                <Border x:Name="PART_TITLEBAR" DockPanel.Dock="Top" Margin="0" Height="30" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" MouseLeftButtonDown="PART_TITLEBAR_MouseLeftButtonDown">
                                    <DockPanel LastChildFill="False">
                                        <Image x:Name="PART_ICON" DockPanel.Dock="Left" Source="{TemplateBinding Icon}" Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center" />

                                        <TextBlock x:Name="PART_TITLE" DockPanel.Dock="Left" Text="{TemplateBinding Title}" Margin="8,0,0,1" Padding="0" VerticalAlignment="Center" Foreground="{DynamicResource ChromeForegroundBrush}" FontSize="12" />

                                        <Button x:Name="PART_CLOSE" DockPanel.Dock="Right" Margin="2,0,6,0" Click="PART_CLOSE_Click" Style="{StaticResource WindowCloseButton}">
                                            <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" />
                                        </Button>

                                        <Button x:Name="PART_MAXIMIZE_RESTORE" DockPanel.Dock="Right" Click="PART_MAXIMIZE_RESTORE_Click" Style="{StaticResource WindowControlButton}">
                                            <Path Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" />
                                        </Button>

                                        <Button x:Name="PART_MINIMIZE" DockPanel.Dock="Right" Click="PART_MINIMIZE_Click" Style="{StaticResource WindowControlButton}">
                                            <Path Data="M 0,5 L 10,5" />
                                        </Button>
                                    </DockPanel>
                                </Border>

                                <AdornerDecorator DockPanel.Dock="Bottom">
                                    <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                                </AdornerDecorator>
                            </DockPanel>
                            <Thumb x:Name="PART_RESIZE_BOTRIGHT" DragDelta="PART_RESIZE_BOTRIGHT_DragDelta" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Style="{StaticResource DragThumb}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=WindowState}" Value="Maximized">
                            <Setter TargetName="PART_RESIZE_BOTRIGHT" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=ResizeMode}" Value="NoResize">
                            <Setter TargetName="PART_RESIZE_BOTRIGHT" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=ShowTitleBar}" Value="False">
                            <Setter TargetName="PART_TITLEBAR" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=ShowIcon}" Value="False">
                            <Setter TargetName="PART_ICON" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=ShowTitle}" Value="False">
                            <Setter TargetName="PART_TITLE" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=ShowMinimize}" Value="False">
                            <Setter TargetName="PART_MINIMIZE" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=ShowMaximize}" Value="False">
                            <Setter TargetName="PART_MAXIMIZE_RESTORE" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=ShowClose}" Value="False">
                            <Setter TargetName="PART_CLOSE" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--
        Dialog buttons follow one hierarchy so each dialog reads at a glance:
          WindowButton    - primary, accent filled (the one action the dialog is for)
          SecondaryButton - raised surface + border (supporting action, e.g. Apply)
          NeutralButton   - ghost, transparent until hovered (dismiss / reset)
        All three share geometry, so they line up cleanly next to each other.
    -->
    <Style x:Key="WindowButton" TargetType="{x:Type Button}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{DynamicResource ChromeAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="5" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChromeAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ChromeMutedBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowButton_SM" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowButton}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowButton}">
        <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ChromeSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="5" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChromeSurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource ChromeMutedBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton_SM" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <Style x:Key="SuccessButton" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowButton}" />

    <Style x:Key="SuccessButton_SM" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowButton_SM}" />

    <Style x:Key="ErrorButton" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowButton}">
        <Setter Property="Background" Value="{DynamicResource ChromeDangerBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="5" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ErrorButton_SM" TargetType="{x:Type Button}" BasedOn="{StaticResource ErrorButton}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <Style x:Key="NeutralButton" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowButton}">
        <Setter Property="Foreground" Value="{DynamicResource ChromeMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="5" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChromeSurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ChromeMutedBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NeutralButton_SM" TargetType="{x:Type Button}" BasedOn="{StaticResource NeutralButton}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <Style x:Key="WindowButtons" TargetType="{x:Type StackPanel}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="20" />
        <Style.Resources>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}" />
        </Style.Resources>
    </Style>

    <Style x:Key="WindowButtons_SM" TargetType="{x:Type StackPanel}" BasedOn="{StaticResource WindowButtons}">
        <Setter Property="Margin" Value="15" />
        <Style.Resources>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton_SM}" />
        </Style.Resources>
    </Style>
</ResourceDictionary>