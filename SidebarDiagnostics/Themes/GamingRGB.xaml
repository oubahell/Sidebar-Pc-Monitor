<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Gaming RGB: near-black chrome with a neon cyan/magenta/purple accent trio, matching the app icon. -->

    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#0D0D14" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#00F0FF" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#7B61FF" />
    <SolidColorBrush x:Key="ChromeAccentBrush" Color="#FF2D75" />
    <SolidColorBrush x:Key="ChromeAccentHoverBrush" Color="#E01F63" />
    <SolidColorBrush x:Key="ChromeMutedBrush" Color="#7C8798" />
    <!-- Slightly raised surface used for secondary buttons, inputs and hover states. -->
    <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#16161F" />
    <SolidColorBrush x:Key="ChromeSurfaceHoverBrush" Color="#20202C" />
    <SolidColorBrush x:Key="ChromeDangerBrush" Color="#FF2D75" />
    <Color x:Key="ChromeShadowColor">#7B61FF</Color>

    <!-- Third-party drop-downs (the Xceed pickers) paint themselves from the system palette
         rather than our brushes, so their popups render stock white unless it is overridden. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0D0D14" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#00F0FF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#16161F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#00F0FF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF2D75" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7C8798" />

</ResourceDictionary>
