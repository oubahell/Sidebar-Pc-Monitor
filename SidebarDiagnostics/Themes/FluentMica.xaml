<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 Fluent: neutral gray chrome and a light system-accent blue, approximating native Windows 11
         dialogs. True Mica blur isn't available to classic WPF windows, so this leans on extra background
         transparency (set via BGOpacity) to get a similar translucent feel. -->

    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#454545" />
    <SolidColorBrush x:Key="ChromeAccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="ChromeAccentHoverBrush" Color="#429CE3" />
    <SolidColorBrush x:Key="ChromeMutedBrush" Color="#A6A6A6" />
    <!-- Slightly raised surface used for secondary buttons, inputs and hover states. -->
    <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#383838" />
    <SolidColorBrush x:Key="ChromeSurfaceHoverBrush" Color="#454545" />
    <SolidColorBrush x:Key="ChromeDangerBrush" Color="#C42B1C" />
    <Color x:Key="ChromeShadowColor">#000000</Color>

    <!-- Third-party drop-downs (the Xceed pickers) paint themselves from the system palette
         rather than our brushes, so their popups render stock white unless it is overridden. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2C2C2C" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F3F3F3" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#383838" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F3F3F3" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#60CDFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#000000" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#A6A6A6" />

</ResourceDictionary>
