<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 Fluent: neutral gray chrome and a light system-accent blue, approximating native Windows 11
         dialogs. True Mica blur isn't available to classic WPF windows, so this leans on extra background
         transparency (set via BGOpacity) to get a similar translucent feel. -->

    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#454545" />
    <SolidColorBrush x:Key="ChromeAccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="ChromeAccentHoverBrush" Color="#429CE3" />
    <SolidColorBrush x:Key="ChromeMutedBrush" Color="#A6A6A6" />
    <Color x:Key="ChromeShadowColor">#000000</Color>

</ResourceDictionary>
